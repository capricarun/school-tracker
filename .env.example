# Public HTTPS address of the app (used in invite links). Push notifications need HTTPS.
PUBLIC_URL=https://school.example.com
# Only needed with the bundled Caddy (docker-compose.yml): the domain pointing at this server.
DOMAIN=school.example.com

# Time zone the family lives in. Reminder times (7 PM evening-before, 7 AM morning-of) use it.
TZ=Asia/Kolkata

# Claude API key for reading school messages. Leave empty to use the built-in date reader.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Web Push keys. Leave empty and they are generated once and stored in the database.
# To set your own: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Set to false after your family is created, so strangers can't create families on your server.
ALLOW_SIGNUP=true

# Image to run (CI publishes ghcr.io/<owner>/school-tracker)
IMAGE=ghcr.io/capricarun/school-tracker:latest
